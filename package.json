{
  "name": "idd",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node node_modules/typescript/bin/tsc -p tsconfig.build.json && node test/index.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "check": "node temp/check-extract.mjs",
    "play": "node node_modules/typescript/bin/tsc -p tsconfig.build.json && node scripts/play.mjs",
    "ui:build": "node node_modules/typescript/bin/tsc -p tsconfig.ui.json && node scripts/build-ui.mjs",
    "ui:check": "node scripts/check-ui.mjs",
    "verify": "npm run typecheck && npm run test && npm run ui:build && npm run ui:check"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^1.6.0"
  }
}

